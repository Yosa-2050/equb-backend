PORT=5050

# PostgreSQL connection (use your Supabase project's Connection Info in prod)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_NAME=equb_db
# Set to true for Supabase / any hosted Postgres that requires SSL
DB_SSL=false

TELEGRAM_BOT_TOKEN=your_bot_token
JWT_SECRET=change_me

# Dev-only: set to true to enable the /auth/dev-login endpoint
DEV_LOGIN=false
DEV_TELEGRAM_ID=900000001

# development | production. In production, dev-login is always disabled and
# CORS_ORIGIN becomes required.
NODE_ENV=development

# Comma-separated list of allowed origins, required when NODE_ENV=production
CORS_ORIGIN=

# Deployed mini app URL (no trailing slash). Used to build the "Open App"
# button the bot sends from /start.
MINI_APP_URL=

# Cloudinary (used to store payment receipt photos)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret